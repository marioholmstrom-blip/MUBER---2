{
  "routes": [
    {
      "route": "/legal",
      "redirect": "/legal/index.html",
      "statusCode": 301
    },
    {
      "route": "/legal/",
      "rewrite": "/legal/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/legal/*",
      "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico}"
    ]
  }
}
